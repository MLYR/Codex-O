{
  "name": "codex-o",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "check": "npm run lint && npm run typecheck && npm test -- --run && node scripts/check-progress.mjs PROGRESS.md",
    "check:m1": "CODEX_O_M1_GATE_OUTPUT=target/m1-beta/m1-gate.json CODEX_O_M1_REAL_BETA=1 CODEX_O_M1_REPO_ROOT=.. cargo test --manifest-path src-tauri/Cargo.toml m1_gate::write_m1_gate_report -- --exact --nocapture && node scripts/check-m1-gate.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
